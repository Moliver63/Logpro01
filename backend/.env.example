PORT=3333
# Postgres. No Render, use a Internal Database URL do serviço logpro-db.
DATABASE_URL=

# Login com Google (console.cloud.google.com > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública do backend — usada para montar o redirect URI do OAuth.
BACKEND_PUBLIC_URL=http://localhost:3333
# E-mail promovido a administrador no start. O primeiro admin precisa vir
# de fora, senão não existe ninguém para promover ninguém.
ADMIN_EMAIL=
ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_CHAT_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Origem(ns) permitida(s) pelo CORS, separadas por vírgula.
FRONTEND_ORIGIN=https://logpro-frontend.onrender.com
# Libera http://localhost no CORS — usar apenas em desenvolvimento local.
PERMITIR_CORS_LOCALHOST=true

# Integração Transerve (transporte). Credenciais fornecidas pela Transerve —
# desenvolvimento e produção são independentes. Nunca commitar valores reais.
# Dev:  https://p0cpuwexqe.execute-api.us-east-1.amazonaws.com
# Prod: https://api-producao-transerve.com
TRANSERVE_BASE_URL=
TRANSERVE_CLIENT_ID=
TRANSERVE_CLIENT_SECRET=
