PORT=3333
DATABASE_PATH=./logpro.db
ALPHA_VANTAGE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_CHAT_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Origem(ns) permitida(s) pelo CORS, separadas por vírgula.
FRONTEND_ORIGIN=https://logpro-frontend.onrender.com
# Libera http://localhost no CORS — usar apenas em desenvolvimento local.
PERMITIR_CORS_LOCALHOST=true

# Integração Transerve (transporte). Credenciais fornecidas pela Transerve —
# desenvolvimento e produção são independentes. Nunca commitar valores reais.
# Dev:  https://p0cpuwexqe.execute-api.us-east-1.amazonaws.com
# Prod: https://api-producao-transerve.com
TRANSERVE_BASE_URL=
TRANSERVE_CLIENT_ID=
TRANSERVE_CLIENT_SECRET=
